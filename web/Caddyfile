{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	# Basemap tiles (milestone 2), served straight from disk with range requests.
	handle_path /tiles/* {
		root * /srv/tiles
		file_server
	}

	handle {
		root * /srv/web
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		# Everything else (the service worker, the manifest, and index.html under every app route such as
		# /calendar) must always be revalidated, so updates reach browsers and installed phones.
		@entry not path /assets/*
		header @entry Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
