# Copy to .env and fill in. Paths are on the Docker host.

# Where the database, photos, tiles and Tailscale state live. On Unraid use a cache-pool path,
# e.g. /mnt/cache/appdata/housetrack, not /mnt/user (slow for PostgreSQL).
DATA_DIR=/srv/housetrack
# Backups; ideally on different disks from DATA_DIR (on Unraid, an array share).
BACKUP_DIR=/srv/backups/housetrack

DB_PASSWORD=change-me
TZ=Australia/Melbourne

# Region pack and search area (minLon,minLat,maxLon,maxLat). The basemap and routing cover only this
# box; addresses cover the whole state. Leave BBOX empty for the region's default (all of Victoria).
REGION=vic
BBOX=

# Tailscale: create a reusable auth key in the admin console, and turn on MagicDNS and HTTPS
# certificates. The app is then at https://$TS_HOSTNAME.<your-tailnet>.ts.net
TS_AUTHKEY=tskey-auth-xxxxx
TS_HOSTNAME=house

# Optional: a free ArcGIS Location Platform key for the map's satellite photos, as Esri's terms ask
# (developers.arcgis.com → sign up → API keys → new key with "Basemaps" allowed). Free up to 2 million tiles a month.
ARCGIS_API_KEY=

# rclone remote for the nightly offsite copy, configured in $DATA_DIR/rclone/rclone.conf,
# e.g. an sftp remote pointing at a laptop on the tailnet.
OFFSITE_TARGET=laptop:backups/housetrack

# Published images: ghcr.io/$IMAGE_OWNER/housetrack-{api,web}:$VERSION. Leave unset to build locally.
# IMAGE_OWNER=your-github-user
# VERSION=latest
